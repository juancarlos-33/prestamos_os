[Unit]
Description=Servidor Web PrestamoOS (FastAPI / Uvicorn) - Sistemas Operativos
After=network.target prestamo-daemon.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/prestamos_os
ExecStart=/opt/prestamos_os/venv/bin/uvicorn src.web.app:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3s

# Seguridad y aislamiento en Linux
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prestamo-web

[Install]
WantedBy=multi-user.target
